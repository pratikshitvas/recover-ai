generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  PATIENT
  CAREGIVER
  THERAPIST
  CLINIC_ADMIN
  PLATFORM_ADMIN
}
enum ConsentType {
  TERMS
  PRIVACY
  CAMERA_AUDIO
  CAREGIVER
  AI_PROCESSING
}
enum SessionStatus {
  STARTED
  COMPLETED
  CANCELLED
  FAILED
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient?
  therapist Therapist?
  memberships ClinicMembership[]
  consents Consent[]
  auditLogs AuditLog[]
}
model Patient {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  language String @default("en")
  birthYear Int?
  createdAt DateTime @default(now())
  assignments PatientTherapistAssignment[]
  exerciseAssignments ExerciseAssignment[]
  sessions RehabilitationSession[]
  assessments MovementAssessment[]
  appointments Appointment[]
  outcomes PatientReportedOutcome[]
  notes TherapistNote[]
}
model Therapist {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  qualifications String?
  assignments PatientTherapistAssignment[]
  notes TherapistNote[]
}
model Clinic {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  memberships ClinicMembership[]
}
model ClinicMembership {
  id String @id @default(cuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role
  createdAt DateTime @default(now())
  @@unique([clinicId, userId])
}
model PatientTherapistAssignment {
  id String @id @default(cuid())
  approved Boolean @default(false)
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapistId String
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([patientId, therapistId])
}
model Consent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type ConsentType
  granted Boolean
  version String
  createdAt DateTime @default(now())
  @@index([userId, type])
}
model ExerciseLibrary {
  id String @id @default(cuid())
  name String
  description String
  instructions String
  targetArea String
  restrictions String?
  createdById String
  createdAt DateTime @default(now())
  assignments ExerciseAssignment[]
}
model ExerciseAssignment {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise ExerciseLibrary @relation(fields: [exerciseId], references: [id])
  repetitions Int?
  sets Int?
  durationSeconds Int?
  active Boolean @default(true)
  assignedAt DateTime @default(now())
}
model RehabilitationSession {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  completedAt DateTime?
  status SessionStatus @default(STARTED)
  discomfort Int?
  fatigue Int?
  note String?
}
model MovementAssessment {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestKey String @unique
  exercise String
  status SessionStatus @default(STARTED)
  confidence Float?
  summary String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  measurements JointMeasurement[]
  @@index([patientId, startedAt])
}
model JointMeasurement {
  id String @id @default(cuid())
  assessmentId String
  assessment MovementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  joint String
  angleDegrees Float
  confidence Float
  observedAt DateTime @default(now())
}
model PatientReportedOutcome {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  discomfort Int?
  fatigue Int?
  assistance String?
  note String?
  createdAt DateTime @default(now())
}
model TherapistNote {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapistId String
  therapist Therapist @relation(fields: [therapistId], references: [id])
  body String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Appointment {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt DateTime?
  status String @default("SCHEDULED")
  createdAt DateTime @default(now())
  @@index([patientId, startsAt])
}
model CreditLedger {
  id String @id @default(cuid())
  userId String
  delta Int
  reason String
  idempotencyKey String @unique
  createdAt DateTime @default(now())
}
model Plan {
  id String @id @default(cuid())
  name String
  priceMinor Int
  currency String @default("INR")
  assessmentAllowance Int
  active Boolean @default(true)
}
model Subscription {
  id String @id @default(cuid())
  userId String
  planId String
  status String
  provider String?
  providerRef String?
  currentPeriodEnd DateTime?
  createdAt DateTime @default(now())
}
model Payment {
  id String @id @default(cuid())
  userId String
  amountMinor Int
  currency String
  status String
  provider String
  providerRef String?
  createdAt DateTime @default(now())
}
model SpeechRecording {
  id String @id @default(cuid())
  patientId String
  consentId String
  storageKey String
  durationSeconds Int?
  createdAt DateTime @default(now())
  deletedAt DateTime?
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  user User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action String
  targetType String
  targetId String?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}