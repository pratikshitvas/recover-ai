{
  "name": "recoverai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @recoverai/web",
    "dev:web": "npm run dev --workspace @recoverai/web",
    "dev:api": "npm run dev --workspace @recoverai/api",
    "build:web": "npm run build --workspace @recoverai/web",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @recoverai/api",
    "dev:mobile": "npm run start --workspace @recoverai/mobile",
    "build:android": "npm run export:android --workspace @recoverai/mobile",
    "build:ios": "npm run export:ios --workspace @recoverai/mobile",
    "dev:desktop": "npm run dev --workspace @recoverai/desktop",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "package:desktop:dir": "npm run build:web && npm run prepare:desktop && npm run package:dir --workspace @recoverai/desktop",
    "build:desktop": "npm run build:web && npm run prepare:desktop && npm run package:win --workspace @recoverai/desktop",
    "build:desktop:mac": "npm run build:web && npm run prepare:desktop && npm run package:mac --workspace @recoverai/desktop",
    "start": "npm run start --workspace @recoverai/api",
    "start:api": "npm run start --workspace @recoverai/api",
    "db:push": "npm run db:push --workspace @recoverai/api"
  },
  "engines": {
    "node": ">=22.13"
  }
}
